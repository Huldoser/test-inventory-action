{
  "name": "test-inventory-action",
  "version": "0.2.4",
  "private": true,
  "description": "GitHub Action that comments on each pull request with what it does to the tests, without running them.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huldoser/test-inventory-action.git"
  },
  "license": "MIT",
  "author": "Andrey Rychkov",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts --check",
    "changeset": "changeset"
  },
  "dependencies": {
    "test-inventory": "0.12.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "~22.12.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "~10.15.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.73.0",
    "vitest": "5.1.1"
  }
}
